# Local development only; all mutable data is outside the source checkout.
YIFUN_DATA_ROOT=/absolute/path/yifun-data
YIFUN_DB=/absolute/path/yifun-data/database/workplace.sqlite3
YIFUN_STORAGE_ROOT=/absolute/path/yifun-data/objects
YIFUN_LOG_ROOT=/absolute/path/yifun-data/logs

# Cloud: r2 requires both endpoint and secret; no local fallback.
YIFUN_OBJECT_BACKEND=local
# YIFUN_OBJECT_ENDPOINT=https://your-private-object-worker.example
# YIFUN_OBJECT_TOKEN=set-through-cloudflare-secrets
